# Copy to .env and supply your own local values. Do not commit .env.
DATABASE_URL="postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/YOUR_DB_NAME?schema=public"

# Required: at least 32 bytes of private random data; no default is supplied.
NEXTAUTH_SECRET=""

# Optional one-time administrator bootstrap. Password must be at least 12 characters.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Administrator"
